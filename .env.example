# Copy this file to .env and fill in your values. Never commit .env.
# Find the endpoint on your project's overview page in the Foundry portal.
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>

# The DEPLOYMENT name you chose in the portal (not the model name).
CHAT_DEPLOYMENT=<your-chat-deployment-name>

# Judge model for evaluation (S01): the Azure OpenAI endpoint of the resource that hosts
# the judge deployment. Foundry portal > the deployment > endpoint (Target URI without the path).
JUDGE_ENDPOINT=https://<your-resource>.openai.azure.com

# Shown in the app header. Change it once you name the product (by S04).
PRODUCT_NAME=Property Service Desk
